{
  "name": "@gainium/backtester",
  "version": "1.0.10",
  "description": "High-performance TypeScript backtesting engine for DCA and Grid trading strategies with comprehensive analytics and real-time optimization capabilities",
  "keywords": [
    "backtesting",
    "trading",
    "dca",
    "grid-trading",
    "cryptocurrency",
    "typescript",
    "trading-bot",
    "technical-analysis",
    "algorithmic-trading",
    "financial-analysis",
    "gainium"
  ],
  "author": {
    "name": "Maksym Shamko",
    "email": "max.shamko25@gmail.com",
    "url": "https://github.com/maksymshamko"
  },
  "organization": {
    "name": "Gainium",
    "url": "https://gainium.io/",
    "github": "https://github.com/Gainium"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./dist/dca": {
      "types": "./dist/dca/index.d.ts",
      "default": "./dist/dca/index.js"
    },
    "./dist/grid": {
      "types": "./dist/grid/index.d.ts",
      "default": "./dist/grid/index.js"
    },
    "./dist/types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./dca": {
      "types": "./dist/dca/index.d.ts",
      "default": "./dist/dca/index.js"
    },
    "./grid": {
      "types": "./dist/grid/index.d.ts",
      "default": "./dist/grid/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "scripts/**/*",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.10",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "uuid": "^11.1.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:clean": "rm -rf dist && npm run build",
    "build:watch": "tsc --project tsconfig.json --watch",
    "lint": "tsc --project tsconfig.json --noEmit && eslint . --cache",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "rebuild": "npm run clean && npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "pull": "git pull origin main",
    "push": "git push origin main",
    "fullInit": "yarn update:indicators",
    "build:indicators": "cd node_modules/@gainium/indicators && npm run build",
    "update:indicators": "export GAINIUM_INDICATORS=@gainium/indicators && npm uninstall $GAINIUM_INDICATORS && npm cache clean --force && rm -rf node_modules/$GAINIUM_INDICATORS && npm install $GAINIUM_INDICATORS@git+https://github.com/Gainium/indicators.git && unset GAINIUM_INDICATORS",
    "postinstall": "npm run build:if-needed",
    "build:if-needed": "npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@gainium/indicators": "github:Gainium/indicators",
    "csv-parser": "^3.2.0",
    "external-sorting": "^1.3.1"
  }
}
