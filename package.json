{
  "name": "@gainium/backtester",
  "version": "1.0.0",
  "description": "High-performance TypeScript backtesting engine for DCA and Grid trading strategies with comprehensive analytics and real-time optimization capabilities",
  "keywords": [
    "backtesting",
    "trading",
    "dca",
    "grid-trading",
    "cryptocurrency",
    "typescript",
    "trading-bot",
    "technical-analysis",
    "algorithmic-trading",
    "financial-analysis",
    "gainium"
  ],
  "author": {
    "name": "Maksym Shamko",
    "email": "max.shamko25@gmail.com",
    "url": "https://github.com/maksymshamko"
  },
  "organization": {
    "name": "Gainium",
    "url": "https://gainium.io/",
    "github": "https://github.com/Gainium"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dca": {
      "types": "./dist/dca/index.d.ts",
      "default": "./dist/dca/index.js"
    },
    "./grid": {
      "types": "./dist/grid/index.d.ts",
      "default": "./dist/grid/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "scripts/**/*",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gainium/backtester.git"
  },
  "bugs": {
    "url": "https://github.com/Gainium/backtester/issues"
  },
  "homepage": "https://github.com/Gainium/backtester#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --project tsconfig.json --noEmit",
    "lint:fix": "prettier --write src examples",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "./scripts/build-if-needed.sh",
    "build:if-needed": "./scripts/build-if-needed.sh",
    "rebuild": "npm run clean && npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "pull": "git pull origin main",
    "push": "git push origin main"
  },
  "dependencies": {
    "@gainium/indicators": "git+https://github.com/Gainium/indicators.git",
    "csv-parser": "^3.0.0",
    "external-sorting": "^1.3.1",
    "typescript": "^5.8.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.24",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "prettier": "^3.5.3"
  }
}
